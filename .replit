# Replit configuration — click Run: installs dependencies, builds, and serves the site on port 5000.
modules = ["nodejs-22"]
run = "npm run replit"
entrypoint = "index.html"

[nix]
channel = "stable-24_11"

[deployment]
deploymentTarget = "static"
build = ["sh", "-c", "npm install --no-audit --no-fund && npm run build:web"]
publicDir = "dist"

[[ports]]
localPort = 5000
externalPort = 80
