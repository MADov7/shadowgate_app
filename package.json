{
  "name": "shadow-gate-storefront",
  "private": true,
  "version": "1.0.0",
  "description": "SHADOW GATE — cinematic, scroll-driven cybersecurity service storefront (classwork project).",
  "type": "module",
  "scripts": {
    "dev": "next dev -p 3190",
    "build": "next build",
    "start": "next start -p 4190",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "ad:dev": "vite --port 5190 --strictPort",
    "landmask": "node scripts/build-landmask.mjs",
    "shot": "node scripts/shot.mjs",
    "db:check": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --import tsx scripts/check-db.ts",
    "seed": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --import tsx scripts/seed.ts",
    "images:products": "node --import tsx scripts/gen-product-images.tsx",
    "build:netlify": "next build --webpack",
    "demo:atlas-edit": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --import tsx scripts/demo-atlas-edit.ts",
    "db:report": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --import tsx scripts/db-report.ts"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "@fontsource-variable/manrope": "^5.2.8",
    "@fontsource/tajawal": "^5.2.7",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@react-three/postprocessing": "^3.2.2",
    "bcryptjs": "^3.0.3",
    "gsap": "^3.15.0",
    "jsonwebtoken": "^9.0.3",
    "lenis": "^1.3.27",
    "lucide-react": "^1.66.0",
    "mongoose": "^9.12.0",
    "next": "^16.4.5",
    "postprocessing": "^6.39.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.187.0",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/d3-geo": "^3.1.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.15.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.187.0",
    "@types/topojson-client": "^3.1.5",
    "@vitejs/plugin-react": "^5.2.0",
    "d3-geo": "^3.1.1",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4.3.5",
    "topojson-client": "^3.1.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vite": "^7.3.7",
    "vitest": "^3.2.7",
    "world-atlas": "^2.0.2"
  },
  "engines": {
    "node": ">=20.19"
  }
}
