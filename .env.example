# Copy to .env.local and fill in. NEVER commit real values (.env* is git-ignored).
# Server-only settings — set the same names in Netlify / Vercel (Environment variables).

# Supabase (Project Settings → API / API Keys)
SUPABASE_URL=
# Publishable / anon key — public reads (products) + password log-in. Row Level Security protects the tables.
SUPABASE_ANON_KEY=
# Secret / service_role key — server only: creates accounts and reads/writes orders. Never NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Signs the HttpOnly session cookie issued after Supabase Auth accepts the password.
JWT_SECRET=

# Stripe TEST MODE secret key (starts with sk_test_). Live keys are refused by the server.
STRIPE_SECRET_KEY=
# Signing secret of the Stripe webhook endpoint /api/stripe/webhook (starts with whsec_).
STRIPE_WEBHOOK_SECRET=
